      "light": "--dsh-bg-active",
      "dark": "--dsh-bg-active"
    },
    "--dsw-alias-bg-overlay": {
      "light": "--dsh-bg-surface",
      "dark": "--dsh-bg-surface"
    },
    "--dsw-alias-border-l1": {
      "light": "--dsh-border-subtle",
      "dark": "--dsh-border-subtle"
    },
    "--dsw-alias-border-l2": {
      "light": "--dsh-border-subtle",
      "dark": "--dsh-border-subtle"
