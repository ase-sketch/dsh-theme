{
  "name": "dsh-theme",
  "version": "0.1.0",
  "description": "dsh-ui 设计规范皮肤插件：自包含样式注入 + 设置面板开关（开关状态由 host 半落盘）",
  "type": "module",
  "license": "MIT",
  "main": "host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-client-ui-session",
        "dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "host",
    "lib",
    "assets",
    "cordis.patch.yml"
  ]
}
