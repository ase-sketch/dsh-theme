{
  "name": "dsh-theme",
  "version": "0.1.0",
  "description": "DeepSeek Harness 压印主题：纸面质感、今日工作台、Deepy 状态精灵与 Lucide 图标层。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.7"
  },
  "main": "host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-client-ui-session",
        "dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "host",
    "lib",
    "assets",
    "cordis.patch.yml"
  ]
}
